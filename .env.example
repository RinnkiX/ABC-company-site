# 到 https://dashboard.clerk.com 创建 Application 后获取 Keys
# 然后复制本文件为 .env 并填入真实值
PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_你的公钥
CLERK_SECRET_KEY=sk_test_你的私钥

# Aurinko 应用凭证： https://app.aurinko.io
AURINKO_CLIENT_ID=你的clientId
AURINKO_CLIENT_SECRET=你的secret
AURINKO_REDIRECT_URI=http://localhost:4321/api/aurinko/callback

# Upstash Redis（Vercel Integrations 自动注入的变量名）
KV_REST_API_URL=你的redis_rest_url
KV_REST_API_TOKEN=你的redis_rest_token
KV_REST_API_READ_ONLY_TOKEN=你的redis_read_only_token
