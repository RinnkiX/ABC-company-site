---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ArticleList from '../components/ArticleList.astro';
import Likes from '../components/Likes.jsx';
import HomeCta from '../components/HomeCta.jsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<Hero
				title="Empowering Your Business With Digital Excellence"
				slogan="We build scalable, high-impact solutions to help you grow with confidence."
			/>

			<section class="intro">
				<div class="intro-grid">
					<div class="intro-text">
						<h2>About ABC Company</h2>
						<p>
							As a trusted corporate partner, ABC Company specializes in delivering
							strategic digital solutions. From Business Strategy to Web Development,
							Branding & Identity to Digital Marketing, we help organizations grow
							with confidence.
						</p>
						<a href="/about" class="button">Read more about us →</a>
					</div>
					<div class="intro-image">
						<img src="/images/viora/about/about-1.jpg" alt="ABC Company team at work" />
					</div>
				</div>

				<div class="intro-stats">
					<div class="stat">
						<strong>10+</strong>
						<span>Years of Experience</span>
					</div>
					<div class="stat">
						<strong>250+</strong>
						<span>Successful Projects</span>
					</div>
					<div class="stat">
						<strong>50+</strong>
						<span>Corporate Clients</span>
					</div>
					<div class="stat">
						<strong>98%</strong>
						<span>Client Satisfaction</span>
					</div>
				</div>
			</section>

			<ArticleList />

			<section class="interactive-demo">
				<h2>Interactive Demo</h2>
				<p>This React island runs inside the Astro page:</p>
				<Likes client:load />
			</section>

			<HomeCta client:load />
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin: 3rem 0;
		padding: 2rem;
		background: white;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
	}
	.intro-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
	}
	.intro-image img {
		width: 100%;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
	}
	.intro-stats {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
		gap: 1rem;
		margin-top: 2rem;
		padding-top: 2rem;
		border-top: 1px solid rgb(var(--gray-light));
	}
	.intro-stats .stat {
		text-align: center;
	}
	.intro-stats strong {
		display: block;
		font-size: 2rem;
		color: var(--accent);
	}
	.intro-stats span {
		font-size: 0.9rem;
		color: rgb(var(--gray));
	}
	.intro .button {
		display: inline-block;
		margin-top: 0.5rem;
		padding: 0.75rem 1.5rem;
		background: var(--accent);
		color: white;
		text-decoration: none;
		border-radius: 6px;
		font-weight: 700;
	}
	.intro .button:hover {
		background: var(--accent-dark);
	}
	@media (max-width: 720px) {
		.intro-grid {
			grid-template-columns: 1fr;
		}
	}
	.interactive-demo {
		margin: 3rem 0;
		text-align: center;
	}
	:global(.likes) {
		max-width: 300px;
		margin: 1rem auto;
		padding: 1.5rem;
		background: white;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		text-align: center;
	}
	:global(.likes) h3 {
		margin-top: 0;
	}
	:global(.likes) button {
		padding: 0.5rem 1rem;
		background: var(--accent);
		color: white;
		border: none;
		border-radius: 6px;
		font-size: 1rem;
		cursor: pointer;
	}
	:global(.likes) button:hover {
		background: var(--accent-dark);
	}
	.cta-section {
		margin: 3rem 0;
		padding: 2rem;
		background: white;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		text-align: center;
	}
	.cta-section .button {
		display: inline-block;
		margin-top: 1rem;
		padding: 0.75rem 1.5rem;
		background: var(--accent);
		color: white;
		text-decoration: none;
		border-radius: 6px;
		font-weight: 700;
	}
	.cta-section .button:hover {
		background: var(--accent-dark);
		color: white;
	}
</style>
