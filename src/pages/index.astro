---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ArticleList from '../components/ArticleList.astro';
import Likes from '../components/Likes.jsx';
import HomeCta from '../components/HomeCta.jsx';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<Hero
				title="Empowering Your Business With Digital Excellence"
				slogan="We build scalable, high-impact solutions to help you grow with confidence."
			/>

			<section class="intro reveal">
				<div class="intro-grid">
					<div class="intro-text">
						<h2>About ABC Company</h2>
						<p>
							As a trusted corporate partner, ABC Company specializes in delivering
							strategic digital solutions. From Business Strategy to Web Development,
							Branding & Identity to Digital Marketing, we help organizations grow
							with confidence.
						</p>
						<a href="/about" class="btn btn--primary">Read more about us →</a>
					</div>
					<div class="intro-image">
						<img src="/images/viora/about/about-1.jpg" alt="ABC Company team at work" />
					</div>
				</div>

			</section>

			<ArticleList />

			<section class="interactive-demo">
				<h2>Interactive Demo</h2>
				<p>This React island runs inside the Astro page:</p>
				<Likes client:load />
			</section>

			<HomeCta client:load />
		</main>
		<Footer />
	</body>
</html>

<style>
	.intro {
		margin: var(--section-gap) 0;
		padding: var(--space-4);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-card);
	}
	.intro-grid {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 2rem;
		align-items: center;
	}
	.intro-image img {
		width: 100%;
		border-radius: var(--radius-md);
		box-shadow: var(--shadow-card);
	}
	.interactive-demo {
		margin: var(--section-gap) 0;
		text-align: center;
	}
	:global(.likes) {
		max-width: 300px;
		margin: 1rem auto;
		padding: var(--space-3);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-card);
		text-align: center;
	}
	:global(.likes) h3 {
		margin-top: 0;
	}
	:global(.likes) button {
		margin-top: 0.5rem;
	}
	.cta-section {
		margin: var(--section-gap) 0;
		padding: var(--space-4);
		background: var(--surface);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-card);
		text-align: center;
	}
	.cta-section .btn {
		margin-top: var(--space-2);
	}
	@media (max-width: 768px) {
		.intro-grid {
			grid-template-columns: 1fr;
		}
	}
</style>
