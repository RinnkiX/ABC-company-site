---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort((a, b) => {
	const dateDiff = b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
	if (dateDiff !== 0) return dateDiff;

	const updatedDiff =
		(b.data.updatedDate?.valueOf() ?? 0) - (a.data.updatedDate?.valueOf() ?? 0);
	if (updatedDiff !== 0) return updatedDiff;

	return b.id.localeCompare(a.id);
});
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.page-header {
				text-align: center;
				margin-bottom: var(--space-6);
				padding-top: var(--space-4);
			}
			.page-header h1 {
				margin-bottom: 0.5rem;
			}
			.page-header p {
				color: var(--text-muted);
			}
			ul {
				display: flex;
				flex-wrap: wrap;
				gap: 2rem;
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul li {
				width: calc(50% - 1rem);
			}
			ul li * {
				text-decoration: none;
				transition:
					color var(--duration-fast) var(--ease-out),
					box-shadow var(--duration-fast) var(--ease-out);
			}
			ul li:first-child {
				width: 100%;
				margin-bottom: 1rem;
				text-align: center;
			}
			ul li:first-child img {
				width: 100%;
			}
			ul li:first-child .title {
				font-size: 2.369rem;
			}
			ul li img {
				margin-bottom: 0.5rem;
				border-radius: var(--radius-md);
			}
			ul li a {
				display: block;
			}
			.title {
				margin: 0;
				color: var(--text-strong);
				line-height: 1;
			}
			.date {
				margin: 0;
				font-family: var(--font-mono);
				font-size: 0.875rem;
				color: var(--text-muted);
			}
			ul li a:hover h4,
			ul li a:hover .date {
				color: var(--color-primary);
			}
			ul a:hover img {
				box-shadow: var(--shadow-card);
			}
			@media (max-width: 768px) {
				ul {
					gap: 0.5em;
				}
				ul li {
					width: 100%;
					text-align: center;
				}
				ul li:first-child {
					margin-bottom: 0;
				}
				ul li:first-child .title {
					font-size: 1.563rem;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="page-header">
				<h1>Latest News & Insights</h1>
				<p>Explore the latest updates, stories, and ideas from ABC Company.</p>
			</section>
			<section>
				<ul class="stagger">
					{
						posts.map((post, index) => (
							<li style={`--i: ${index}`}>
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image width={720} height={360} src={post.data.heroImage} alt="" />
									)}
									<h4 class="title">{post.data.title}</h4>
									<p class="date">
										<FormattedDate date={post.data.pubDate} />
									</p>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
