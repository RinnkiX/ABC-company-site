---
import BaseHead from '../components/BaseHead.astro';
import DashboardContent from '../components/DashboardContent.jsx';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Dashboard - ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<DashboardContent client:load />
		</main>
		<Footer />
	</body>
</html>

<style>
	.dashboard-banner {
		width: 100%;
		border-radius: 12px;
		box-shadow: var(--box-shadow);
		margin-bottom: 2rem;
	}
	.welcome {
		margin-bottom: 2rem;
	}
	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1.5rem;
		margin-top: 1rem;
	}
	.stat-card {
		padding: 1.5rem;
		background: white;
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		text-align: center;
	}
	.stat-card h3 {
		font-size: 2rem;
		margin: 0;
		color: var(--accent);
	}
	.stat-card p {
		margin: 0.5rem 0 0;
		color: rgb(var(--gray));
	}
</style>
