---
export interface Props {
	title?: string;
	slogan?: string;
	eyebrow?: string;
	backgroundImage?: string;
}

const {
	title = 'Empowering Your Business With Digital Excellence',
	slogan = 'We build scalable, high-impact solutions to help you grow with confidence.',
	eyebrow = 'Ethical AI · Trusted Technology',
	backgroundImage = '/images/viora/hero/corporate-hero-1.jpg',
} = Astro.props;
---

<section class="hero">
	<div class="hero-copy">
		<p class="hero-eyebrow reveal" style="--reveal-delay: 0ms">{eyebrow}</p>
		<h1 class="reveal" style="--reveal-delay: 80ms">{title}</h1>
		<p class="slogan reveal" style="--reveal-delay: 160ms">{slogan}</p>
		<div class="cta reveal" style="--reveal-delay: 240ms">
			<a href="/about" class="btn btn--primary">Learn More</a>
			<a href="/blog" class="btn btn--ghost">Read Blog</a>
		</div>
	</div>
	<div class="hero-visual-wrap reveal" style="--reveal-delay: 240ms">
		<img class="hero-visual" src={backgroundImage} alt="" />
	</div>
</section>

<style>
	.hero {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: var(--space-6);
		align-items: center;
		max-width: var(--container-max);
		margin-inline: auto;
		padding: clamp(3rem, 6vw, 5rem) var(--container-pad) 0;
	}
	.hero-copy {
		max-width: 560px;
	}
	.hero-eyebrow {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 500;
		letter-spacing: 0.01em;
		text-transform: uppercase;
		color: var(--color-primary);
	}
	.hero h1 {
		margin: 0 0 1rem;
		font-size: clamp(2.5rem, 5vw, 4rem);
		font-weight: 700;
		letter-spacing: var(--tracking-tight);
		line-height: 1.1;
		color: var(--text-strong);
	}
	.slogan {
		margin: 0 0 2rem;
		max-width: 48ch;
		font-size: 1rem;
		line-height: 1.6;
		color: var(--text);
	}
	.cta {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
	}
	.hero-visual-wrap {
		display: flex;
		justify-content: flex-end;
	}
	.hero-visual {
		width: 100%;
		max-width: 560px;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-card);
	}
	@media (max-width: 768px) {
		.hero {
			grid-template-columns: 1fr;
			gap: var(--space-4);
			padding-top: var(--space-4);
		}
		.hero-visual-wrap {
			justify-content: center;
		}
	}
</style>
