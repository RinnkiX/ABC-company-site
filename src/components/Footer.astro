---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} ABC Company. All rights reserved.</p>
	<p class="contact">hello@abc-company.example | +1 (555) 123-4567</p>
</footer>
<style>
	footer {
		padding: 2em 1em 6em 1em;
		background: linear-gradient(var(--gray-gradient)) no-repeat;
		color: rgb(var(--gray));
		text-align: center;
	}
	.contact {
		font-size: 0.9em;
		margin-top: 0.5em;
	}
</style>
