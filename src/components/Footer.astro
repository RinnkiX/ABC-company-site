---
const today = new Date();
---

<footer>
	<p>&copy; {today.getFullYear()} ABC Company. All rights reserved.</p>
	<p class="contact">hello@abc-company.example | +1 (555) 123-4567</p>
</footer>
<style>
	footer {
		padding: var(--space-6) var(--container-pad);
		background: var(--surface-muted);
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		text-align: center;
		font-size: 0.875rem;
	}
	.contact {
		font-family: var(--font-mono);
		font-size: 0.875em;
		margin-top: 0.5em;
	}
</style>
