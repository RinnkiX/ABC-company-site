---
export interface Props {
	title: string;
	description: string;
	href?: string;
	author?: string;
	date?: string;
	category?: string;
}

const { title, description, href, author, date, category } = Astro.props;
---

{
	href ? (
		<a href={href} class="article-card-link">
			<article class="article-card">
				<h2>{title}</h2>
				<p>{description}</p>
				<div class="meta">
					{author && <span>Author: {author}</span>}
					{date && <span>Date: {date}</span>}
					{category && <span>Category: {category}</span>}
				</div>
			</article>
		</a>
	) : (
		<article class="article-card">
			<h2>{title}</h2>
			<p>{description}</p>
			<div class="meta">
				{author && <span>Author: {author}</span>}
				{date && <span>Date: {date}</span>}
				{category && <span>Category: {category}</span>}
			</div>
		</article>
	)
}

<style>
	.article-card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.article-card-link:hover .article-card {
		border-color: var(--accent);
		box-shadow: 0 4px 12px rgba(var(--gray), 20%);
	}
	.article-card {
		padding: 1.5rem;
		border: 1px solid rgb(var(--gray-light));
		border-radius: 8px;
		box-shadow: var(--box-shadow);
		background: white;
		margin-bottom: 1.5rem;
		transition: border-color 0.2s, box-shadow 0.2s;
	}
	.article-card h2 {
		margin-top: 0;
		font-size: 1.5rem;
		color: rgb(var(--black));
	}
	.meta {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		font-size: 0.875rem;
		color: rgb(var(--gray));
		margin-top: 1rem;
	}
</style>
