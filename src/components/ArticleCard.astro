---
export interface Props {
	title: string;
	description: string;
	href?: string;
	author?: string;
	date?: string;
	category?: string;
	class?: string;
	style?: string;
}

const { title, description, href, author, date, category, class: className, style } = Astro.props;
---

{
	href ? (
		<a
			href={href}
			class:list={['article-card-link', className]}
			{...{ style }}
		>
			<article class="article-card">
				<h2>{title}</h2>
				<p>{description}</p>
				<div class="meta">
					{author && <span>Author: {author}</span>}
					{date && <span>Date: {date}</span>}
					{category && <span>Category: {category}</span>}
				</div>
			</article>
		</a>
	) : (
		<article class:list={['article-card', className]} {...{ style }}>
			<h2>{title}</h2>
			<p>{description}</p>
			<div class="meta">
				{author && <span>Author: {author}</span>}
				{date && <span>Date: {date}</span>}
				{category && <span>Category: {category}</span>}
			</div>
		</article>
	)
}

<style>
	.article-card-link {
		display: block;
		text-decoration: none;
		color: inherit;
	}
	.article-card-link:hover .article-card {
		border-color: var(--color-primary);
		box-shadow: var(--shadow-hover);
		transform: translateY(-2px);
	}
	.article-card {
		padding: var(--space-3);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		box-shadow: var(--shadow-card);
		background: var(--surface);
		margin-bottom: var(--space-3);
		transition:
			border-color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}
	.article-card h2 {
		margin-top: 0;
		font-size: 1.5rem;
		color: var(--text-strong);
	}
	.meta {
		display: flex;
		gap: 1rem;
		flex-wrap: wrap;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--text-muted);
		margin-top: 1rem;
	}
</style>
