---
import { SITE_TITLE } from '../consts';
import AuthLinks from './AuthLinks.jsx';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
		<AuthLinks client:load />
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: var(--z-sticky);
		margin: 0;
		padding: 0;
		background: var(--color-secondary);
		box-shadow: var(--shadow-nav);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		max-width: var(--container-max);
		margin-inline: auto;
		padding: 0 var(--container-pad);
	}
	.internal-links,
	.auth-links {
		display: flex;
		align-items: center;
	}
	.auth-links {
		gap: 0.5rem;
	}
	.internal-links {
		margin-inline: auto;
		gap: 0.25rem;
	}
	nav a {
		padding: 1em 0.75em;
		color: var(--text);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}
	nav a:hover {
		color: var(--color-primary);
	}
	nav a.active {
		color: var(--color-primary);
		box-shadow: inset 0 -2px 0 var(--color-primary);
	}
	button.login {
		padding: 0.5em 1em;
		background: var(--color-primary);
		color: white;
		border: none;
		border-radius: var(--radius-sm);
		cursor: pointer;
		font-size: 1em;
	}
	button.login:hover {
		background: var(--color-primary-hover);
	}
</style>

<style is:global>
	.auth-links a.auth-link {
		padding: 0.55em 1.1em;
		border-radius: var(--radius-sm);
		font-weight: 500;
		font-size: 0.875rem;
		text-decoration: none;
		transition:
			background-color var(--duration-fast) var(--ease-out),
			color var(--duration-fast) var(--ease-out),
			border-color var(--duration-fast) var(--ease-out),
			box-shadow var(--duration-fast) var(--ease-out),
			transform var(--duration-fast) var(--ease-out);
	}
	.auth-links a.auth-link:not(.signup) {
		color: var(--color-primary);
		background: transparent;
		border: 1.5px solid var(--border-strong);
	}
	.auth-links a.auth-link:not(.signup):hover {
		background: var(--surface-muted);
	}
	.auth-links a.auth-link.signup {
		background: var(--color-primary);
		color: white;
		border: 1.5px solid var(--color-primary);
	}
	.auth-links a.auth-link.signup:hover {
		background: var(--color-primary-hover);
		border-color: var(--color-primary-hover);
	}
</style>
