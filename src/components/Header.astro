---
import { SITE_TITLE } from '../consts';
import AuthLinks from './AuthLinks.jsx';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>
		<AuthLinks client:load />
	</nav>
</header>

<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
	}
	.internal-links,
	.auth-links {
		display: flex;
		align-items: center;
	}
	.auth-links {
		gap: 0.5rem;
	}
	.internal-links {
		margin-inline: auto;
	}
	nav a {
		padding: 1em 0.5em;
		color: rgb(var(--black));
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	button.login {
		padding: 0.5em 1em;
		background: var(--accent);
		color: white;
		border: none;
		border-radius: 6px;
		cursor: pointer;
		font-size: 1em;
	}
	button.login:hover {
		background: var(--accent-dark);
	}
	@media (max-width: 720px) {
		.internal-links {
			gap: 0.25em;
		}
	}
</style>

<style is:global>
	.auth-links a.auth-link {
		padding: 0.55em 1.1em;
		border-radius: 6px;
		font-weight: 500;
		text-decoration: none;
		transition: all 0.2s ease;
	}
	.auth-links a.auth-link:not(.signup) {
		color: var(--accent);
		background: white;
		border: 1.5px solid var(--accent);
	}
	.auth-links a.auth-link:not(.signup):hover {
		background: var(--accent);
		color: white;
	}
	.auth-links a.auth-link.signup {
		background: var(--accent);
		color: white;
		border: 1.5px solid var(--accent);
	}
	.auth-links a.auth-link.signup:hover {
		background: var(--accent-dark);
		border-color: var(--accent-dark);
	}
</style>
